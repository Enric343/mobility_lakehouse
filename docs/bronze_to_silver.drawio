<mxfile host="65bd71144e">
    <diagram name="Bronze to Silver" id="lineage">
        <mxGraphModel dx="1404" dy="1207" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n1" parent="1" style="text;align=left;verticalAlign=middle;fontSize=13;html=1;whiteSpace=wrap;" value="&lt;b&gt;Bronze → Silver&lt;/b&gt;: which Bronze tables build each Silver table and how.&lt;br&gt;Common rules: English snake_case names, real types, text placeholders → NULL, INE filtered to 2023, zones identified by (zone_level, zone_id). Lineage columns (_source_file, _ingested_at) stay in Bronze." vertex="1">
                    <mxGeometry height="60" width="1200" x="40" y="-90" as="geometry"/>
                </mxCell>
                <mxCell id="n2" parent="1" style="text;align=center;fontSize=12;fontColor=#666666;html=1;whiteSpace=wrap;" value="&lt;b&gt;BRONZE&lt;/b&gt;" vertex="1">
                    <mxGeometry height="20" width="270" x="40" y="-20" as="geometry"/>
                </mxCell>
                <mxCell id="n3" parent="1" style="text;align=center;fontSize=12;fontColor=#666666;html=1;whiteSpace=wrap;" value="&lt;b&gt;TRANSFORMATIONS&lt;/b&gt;" vertex="1">
                    <mxGeometry height="20" width="520" x="400" y="-20" as="geometry"/>
                </mxCell>
                <mxCell id="n4" parent="1" style="text;align=center;fontSize=12;fontColor=#666666;html=1;whiteSpace=wrap;" value="&lt;b&gt;SILVER&lt;/b&gt;" vertex="1">
                    <mxGeometry height="20" width="230" x="1010" y="-20" as="geometry"/>
                </mxCell>
                <mxCell id="n5" parent="1" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;→ silver_fact_trips&lt;/b&gt;&lt;br&gt;• trip_datetime = strptime(fecha || periodo, &#39;%Y%m%d%H&#39;) → TIMESTAMP&lt;br&gt;• origen, destino → origin_zone_id, destination_zone_id&lt;br&gt;• actividad_origen, actividad_destino → origin_activity, destination_activity&lt;br&gt;• trips = SUM(viajes::DOUBLE) GROUP BY the 6 PK columns&lt;br&gt;• Dropped: distancia, estudio_*_posible, residencia, renta, edad, sexo, viajes_km&lt;br&gt;• Foreign and same-zone trips are kept" vertex="1">
                    <mxGeometry height="142" width="520" x="400" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="n6" parent="1" style="rounded=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#555555;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="silver_fact_trips" vertex="1">
                    <mxGeometry height="50" width="230" x="1010" y="66" as="geometry"/>
                </mxCell>
                <mxCell id="n7" parent="1" style="rounded=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="bronze_mitma_od_daily" vertex="1">
                    <mxGeometry height="44" width="270" x="40" y="69" as="geometry"/>
                </mxCell>
                <mxCell id="n8" parent="1" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;→ silver_fact_overnight&lt;/b&gt;&lt;br&gt;• date = strptime(fecha, &#39;%Y%m%d&#39;) → DATE&lt;br&gt;• zona_residencia → residence_district_id (always distritos)&lt;br&gt;• zona_pernoctacion → overnight_zone_id&lt;br&gt;• people = personas::DOUBLE" vertex="1">
                    <mxGeometry height="108" width="520" x="400" y="192" as="geometry"/>
                </mxCell>
                <mxCell id="n9" parent="1" style="rounded=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#555555;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="silver_fact_overnight" vertex="1">
                    <mxGeometry height="50" width="230" x="1010" y="221" as="geometry"/>
                </mxCell>
                <mxCell id="n10" parent="1" style="rounded=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="bronze_mitma_overnight_daily" vertex="1">
                    <mxGeometry height="44" width="270" x="40" y="224" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="1" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;→ silver_dim_zone&lt;/b&gt;&lt;br&gt;• names: ID → zone_id, name → zone_name&lt;br&gt;• geometries: one row per zone, geometry_type pivoted → geom (polygon), centroid&lt;br&gt;• French / Portuguese zones come only from the geometries: zone_name = code&lt;br&gt;• &#39;externo&#39; row added by hand (no geometry)&lt;br&gt;• is_foreign = true for FR*, PT*, externo&lt;br&gt;• province_code = first 2 digits of municipio_ine (mapping); NULL for foreign zones and the 49 lands&lt;br&gt;• municipality_id, gau_id (?) = municipio_mitma, gau_mitma of each district (mapping)" vertex="1">
                    <mxGeometry height="193" width="520" x="400" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="n12" parent="1" style="rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#555555;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="silver_dim_zone" vertex="1">
                    <mxGeometry height="50" width="230" x="1010" y="401.5" as="geometry"/>
                </mxCell>
                <mxCell id="n13" parent="1" style="rounded=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="bronze_mitma_zone_names" vertex="1">
                    <mxGeometry height="44" width="270" x="40" y="348.5" as="geometry"/>
                </mxCell>
                <mxCell id="n14" parent="1" style="rounded=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="bronze_mitma_zone_geometries" vertex="1">
                    <mxGeometry height="44" width="270" x="40" y="404.5" as="geometry"/>
                </mxCell>
                <mxCell id="n15" parent="1" style="rounded=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="bronze_mitma_zone_mapping" vertex="1">
                    <mxGeometry height="44" width="270" x="40" y="460.5" as="geometry"/>
                </mxCell>
                <mxCell id="n16" parent="1" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;→ silver_zone_metrics&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ADRH&lt;/b&gt;: Periodo = 2023; &#39;&#39; and &#39;.&#39; → NULL; Spanish number format → DOUBLE&lt;br&gt;• Section code taken from Secciones; indicador pivoted to one column per indicator&lt;br&gt;• Section → MITMA district with the mapping: exact, by_district, manual, by_municipality&lt;br&gt;• Municipality and GAU come from the district&lt;br&gt;• population = SUM; income, % sources, gini, age = mean weighted by population&lt;br&gt;• &lt;b&gt;DIRCE&lt;/b&gt;: Periodo = 2023, municipality rows, Grupos CNAE pivoted → businesses_*&lt;br&gt;• GAU = sum of its municipalities; NULL for distritos; empty → NULL (not 0)" vertex="1">
                    <mxGeometry height="193" width="520" x="400" y="553" as="geometry"/>
                </mxCell>
                <mxCell id="n17" parent="1" style="rounded=1;arcSize=10;fillColor=#D5E8D4;strokeColor=#555555;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="silver_zone_metrics" vertex="1">
                    <mxGeometry height="50" width="230" x="1010" y="624.5" as="geometry"/>
                </mxCell>
                <mxCell id="n18" parent="1" style="rounded=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="bronze_ine_adrh" vertex="1">
                    <mxGeometry height="44" width="270" x="40" y="599.5" as="geometry"/>
                </mxCell>
                <mxCell id="n19" parent="1" style="rounded=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="bronze_ine_dirce" vertex="1">
                    <mxGeometry height="44" width="270" x="40" y="655.5" as="geometry"/>
                </mxCell>
                <mxCell id="nzrIJlyhB6d35CgQsBHU-1" edge="1" parent="1" source="n20" style="edgeStyle=none;html=1;" target="n25" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n20" parent="1" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;→ silver_dim_province&lt;/b&gt;&lt;br&gt;• CPRO → province_code, Provincia → province_name, CODAUTO → ccaa_code" vertex="1">
                    <mxGeometry height="57" width="520" x="400" y="776" as="geometry"/>
                </mxCell>
                <mxCell id="n21" parent="1" style="rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#555555;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="silver_dim_province" vertex="1">
                    <mxGeometry height="50" width="230" x="1010" y="779.5" as="geometry"/>
                </mxCell>
                <mxCell id="n22" parent="1" style="rounded=1;arcSize=10;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="bronze_ine_provinces" vertex="1">
                    <mxGeometry height="44" width="270" x="40" y="782.5" as="geometry"/>
                </mxCell>
                <mxCell id="n23" parent="1" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;→ silver_dim_ccaa&lt;/b&gt;&lt;br&gt;• SELECT DISTINCT CODAUTO → ccaa_code, Comunidad Autónoma → ccaa" vertex="1">
                    <mxGeometry height="57" width="520" x="400" y="863" as="geometry"/>
                </mxCell>
                <mxCell id="n24" parent="1" style="rounded=1;arcSize=10;fillColor=#DAE8FC;strokeColor=#555555;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="silver_dim_ccaa" vertex="1">
                    <mxGeometry height="50" width="230" x="1010" y="866.5" as="geometry"/>
                </mxCell>
                <mxCell id="n25" parent="1" style="rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;html=1;whiteSpace=wrap;" value="&lt;b&gt;→ silver_holidays&lt;/b&gt;&lt;br&gt;• Rows with empty marca dropped (not a holiday in that region)&lt;br&gt;• date = day from fiesta + month from mes + year → DATE&lt;br&gt;• ccaa → ccaa_code with a hand-written list of the 19 BOE names&lt;br&gt;• holiday_name = fiesta without the day number" vertex="1">
                    <mxGeometry height="108" width="520" x="400" y="950" as="geometry"/>
                </mxCell>
                <mxCell id="n26" parent="1" style="rounded=1;arcSize=10;fillColor=#E1D5E7;strokeColor=#555555;fontStyle=1;fontSize=12;html=1;whiteSpace=wrap;" value="silver_holidays" vertex="1">

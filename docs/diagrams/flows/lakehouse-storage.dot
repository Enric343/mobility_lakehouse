digraph storage {
  graph [rankdir=LR, bgcolor="white", pad=0.24, nodesep=0.36, ranksep=0.8, fontname="Arial", fontcolor="#173346"];
  node [shape=box, style="rounded,filled", color="#8ca5b5", fillcolor="#eef4f7", fontname="Arial", fontcolor="#173346", fontsize=13, margin="0.16,0.11"];
  edge [color="#536e80", fontcolor="#405b6e", fontname="Arial", fontsize=10, arrowsize=0.7];

  raw [label="Original downloads\ndata/raw/\nCSV, shapefiles and XML", fillcolor="#f9efdf"];
  driver [label="Airflow and Python\nSelect and run each step"];
  duckdb [label="DuckDB\nExecutes SQL and attaches DuckLake", fillcolor="#ddecf7"];
  report [label="Offline report\nReads published Gold"];

  subgraph cluster_storage {
    label="Local DuckLake  ·  data/lakehouse/";
    color="#94aebf"; style="rounded"; margin=16; labelloc=t;
    catalog [label="catalog.ducklake\nTables, snapshots and file metadata", fillcolor="#e7eef8"];
    data [label="warehouse/\nParquet rows and partitions", fillcolor="#e7f4ed"];
    {rank=same; catalog; data;}
    catalog -> data [label="Tracks committed files", style=dashed, constraint=false];
  }
  {rank=same; raw; driver;}
  raw -> duckdb [label="Read into staging"];
  driver -> duckdb [label="Run the steps"];
  duckdb -> catalog [label="Attach and commit metadata"];
  duckdb -> data [label="Read and write rows"];
  duckdb -> report [label="Read-only SQL"];
}

digraph reference {
  graph [rankdir=LR, bgcolor="white", pad=0.24, nodesep=0.28, ranksep=0.52, fontname="Arial"];
  node [shape=box, style="rounded,filled", color="#8ca5b5", fillcolor="#eef4f7", fontname="Arial", fontcolor="#173346", fontsize=12, margin="0.15,0.10"];
  edge [color="#536e80", fontcolor="#405b6e", fontname="Arial", fontsize=9, arrowsize=0.66];

  provinces [label="INE provinces and communities", fillcolor="#faecd9"];
  mitma [label="MITMA names, geometry and\nINE section correspondence", fillcolor="#faecd9"];
  boe [label="BOE holiday declarations", fillcolor="#faecd9"];
  ine [label="INE census indicators and\nDIRCE establishment counts", fillcolor="#faecd9"];

  geography [label="Assign provinces, features\nand names to zone keys"];
  calendar [label="Parse dates and resolve\nBOE community names"];
  metrics [label="Parse INE numbers, map sections\nand aggregate published measures"];

  administration [label="silver_dim_ccaa\nsilver_dim_province", fillcolor="#ddecf7"];
  zones [label="silver_dim_zone", fillcolor="#ddecf7"];
  holidays [label="silver_holidays", fillcolor="#ddecf7"];
  measures [label="silver_zone_metrics", fillcolor="#ddecf7"];

  {rank=same; provinces; mitma; boe; ine;}
  {rank=same; geography; calendar; metrics;}
  {rank=same; administration; zones; holidays; measures;}
  provinces -> administration [label="Deduplicate communities"];
  mitma -> geography;
  geography -> zones;
  boe -> calendar;
  calendar -> holidays;
  ine -> metrics;
  mitma -> metrics [label="Map sections to zones"];
  metrics -> measures;
}

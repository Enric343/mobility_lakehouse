digraph trips {
  graph [rankdir=TB, bgcolor="white", pad=0.23, nodesep=0.33, ranksep=0.37, fontname="Arial"];
  node [shape=box, style="rounded,filled", color="#8ca5b5", fontname="Arial", fontcolor="#173346", fontsize=13, margin="0.18,0.10", width=4.1];
  edge [color="#536e80", fontcolor="#405b6e", fontname="Arial", fontsize=11, arrowsize=0.7];
  raw [label="MITMA daily CSV.gz\nA date and zoning level per file", fillcolor="#f1f5f7"];
  bronze [label="bronze_mitma_od_daily\nOne published row per OD-hour and traveller profile", fillcolor="#faecd9"];
  silver [label="silver_fact_trips\nOne OD-hour and activity pair per zoning level", fillcolor="#ddecf7"];
  gold [label="gold_typical_day_patterns\nAverage published trips per OD-hour and pattern", fillcolor="#fff3c9"];
  raw -> bronze [label="Read text fields and attach source lineage"];
  bronze -> silver [label="Type date and hour, sum trips and check totals"];
  silver -> gold [label="Roll up activities, label days and average observed days"];
}
